# @owner SSJ — 운영 환경변수 키 목록 (값은 커밋 금지). EC2 의 /etc/helpnest/helpnest.env 에 값을 채워 chmod 600
# 비어 있으면 기동 실패: DB_URL·DB_USERNAME·DB_PASSWORD·JWT_SECRET·FRONT_ORIGIN·S3_BUCKET·SES_FROM_EMAIL
#                     LLM_API_KEY(LLM_PROVIDER=google-genai 일 때)
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/helpnest
DB_USERNAME=
DB_PASSWORD=
# 32바이트 이상 랜덤 (openssl rand -base64 48)
JWT_SECRET=
# Amplify 도메인 (https://main.xxxx.amplifyapp.com) — CORS·메일 링크
FRONT_ORIGIN=
REFRESH_COOKIE_SECURE=true
# Amplify 빌드 환경변수 PROXY_SECRET 과 반드시 같은 값 (openssl rand -hex 32) — Amplify 경유 요청의 클라이언트 IP 판별용(back #105)
# 비어도 기동은 되지만, Amplify 경유 요청이 전부 Amplify 서버 IP 하나로 묶여 요청 제한을 전체 사용자가 함께 쓴다
PROXY_SECRET=
LLM_PROVIDER=google-genai
LLM_API_KEY=
LLM_MODEL=
AWS_REGION=ap-northeast-2
S3_BUCKET=
SES_FROM_EMAIL=no-reply@helpnest.kro.kr
