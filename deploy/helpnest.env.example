# @owner SSJ — 운영 환경변수 키 목록 (값은 커밋 금지). EC2 의 /etc/helpnest/helpnest.env 에 값을 채워 chmod 600
# 비어 있으면 기동 실패: DB_URL·DB_USERNAME·DB_PASSWORD·JWT_SECRET·FRONT_ORIGIN·S3_BUCKET·SES_FROM_EMAIL
#                     LLM_API_KEY(LLM_PROVIDER=google-genai 일 때)
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/helpnest
DB_USERNAME=
DB_PASSWORD=
# 32바이트 이상 랜덤 (openssl rand -base64 48)
JWT_SECRET=
# Amplify 도메인 (https://main.xxxx.amplifyapp.com) — CORS·메일 링크
FRONT_ORIGIN=
REFRESH_COOKIE_SECURE=true
# Amplify 빌드 환경변수 PROXY_SECRET 과 반드시 같은 값 (openssl rand -hex 32) — Amplify 경유 요청의 클라이언트 IP 판별용(back #105)
# 비어도 기동은 되지만, Amplify 경유 요청이 전부 Amplify 서버 IP 하나로 묶여 요청 제한을 전체 사용자가 함께 쓴다
PROXY_SECRET=
LLM_PROVIDER=google-genai
LLM_API_KEY=
# 모델을 바꿀 때만 주석 해제. 빈 값(LLM_MODEL=)으로 두면 기본 모델 대신 빈 문자열이 들어간다
# LLM_MODEL=gemini-3.5-flash-lite
AWS_REGION=ap-northeast-2
S3_BUCKET=
SES_FROM_EMAIL=no-reply@helpnest.kro.kr
# 가입 이메일 인증 (back #117). true 면 가입 회원이 PENDING 으로 저장되고 메일 링크를 눌러야 로그인된다.
# 끄려면 false 로 바꾸고 systemctl restart (jar 롤백 불필요). front /verify-email 이 main 에 배포된 뒤에 켠다
EMAIL_VERIFICATION=true
# 소셜 로그인 (back #123·#124). 비어 있는 제공자는 꺼진다(기동 실패 없음). 값은 BSJ 가 만든 OAuth 클라이언트
# 제공자 콘솔 Redirect URI: {FRONT_ORIGIN}/api/auth/oauth2/callback/{google|kakao}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
